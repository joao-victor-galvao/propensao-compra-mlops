# Copie para .env (cp .env.example .env) e preencha. O .env nunca é commitado.

# --- MLflow ---
# Servidor do docker compose: http://localhost:5000 (o container pipeline já usa http://mlflow:5000).
# Sem servidor: remova a linha abaixo e o MLflow usa sqlite:///mlflow.db na raiz do projeto.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=purchase-propensity

# --- API de inferência ---
# Caminho local do modelo exportado pelo estágio "register" do DVC
MODEL_PATH=models/champion
# Probabilidade mínima para classificar a sessão como "vai comprar"
DECISION_THRESHOLD=0.5

# --- DVC remote (DagsHub) ---
# Token: DagsHub > Your Settings > Tokens > Default Access Token
DAGSHUB_USER=
DAGSHUB_TOKEN=

# --- Deploy (Hugging Face Spaces) ---
# Token com permissão Write: Hugging Face > Settings > Access Tokens
HF_USER=
HF_TOKEN=
